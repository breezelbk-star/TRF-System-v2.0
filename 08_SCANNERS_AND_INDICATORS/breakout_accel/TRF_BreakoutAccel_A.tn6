{================ TRF-D-Momentum-V2.0 · 趋势动量精选器（南大光电型） ================}
{ 建议路径：indicators/momentum/TRF_D_Momentum_V2_0.tn6 }

N:=20;

{================ ① 趋势与量能基础 =================}
DIF:=EMA(C,12)-EMA(C,26);
DEA:=EMA(DIF,9);

{放量上破MA20（趋势重新转强）}
BRKMA20:=CROSS(C,MA(C,N)) AND V>MA(V,5)*1.3;

{MACD翻红 / 站上（动量恢复）}
MACDUP:=DIF>DEA;

{近2日量能持续强于5日均量}
VOL2DAY:=REF(V,0)>MA(V,5) AND REF(V,1)>MA(V,5);

{今日成交额显著放大}
VALBIG:=AMOUNT>MA(AMOUNT,5)*1.5;

{================ ② KDJ 情绪不过热 =================}
RSV:=(C-LLV(L,9))/(HHV(H,9)-LLV(L,9))*100;
K:=SMA(RSV,3,1);
NOTHOT:=K<85;

{================ ③ 换手率约束 =================}
TURN:=V/CAPITAL*100;

{================ ④ 基础降噪过滤 =================}
TREND:=C>MA(C,60);               {中期多头}
NOTNEW:=BARSCOUNT(C)>120;        {上市时间 >120 日}
PRICEOK:=C>=5 AND C<=120;        {价格带：5~120 元}
LIQUID:=AMOUNT>200000000;        {成交额 ≥2 亿}
TURNOK:=TURN>=2 AND TURN<=20;    {换手率 2%~20%}

{================ ⑤ 近突破 + 多头斜率 =================}
CORE:=BRKMA20 AND MACDUP;        {趋势 + 动量同时满足}
NEARBRK:=C>=HHV(C,20)*0.98;      {收盘接近20日新高 98%}
SLOPEOK:=MA(C,5)>MA(C,10) AND MA(C,10)>MA(C,20);   {5>10>20 多头结构}

{================ ⑥ 最终信号（TRF-D 趋势动量精选） =================}
XG:
    CORE
AND (VOL2DAY OR VALBIG)
AND TREND
AND NOTNEW
AND PRICEOK
AND LIQUID
AND TURNOK
AND NOTHOT
AND NEARBRK
AND SLOPEOK;
