{================ TRF-B-Rebound-V2.0 · 二波反包扫描器（北方华创型） ================}
N:=20;

{① 趋势前提：已经走出第一波主升浪}
M10:=MA(C,10);
M20:=MA(C,20);
M60:=MA(C,60);

FIRSTWAVE:=
    M10 > M20
AND M20 > M60
AND HHV(C,20) / LLV(C,20) > 1.08;   {最近20日涨幅>8%}

{② 回调逻辑：前期有降温/整理}
PULLBACK:=
    REF(C,1) < REF(C,2)                 {昨天收盘弱于前天}
AND REF(L,1) <= REF(M10,1) * 1.02;      {昨天低点回踩/靠近10日线}

{③ 当日反包：重新站回趋势 + 接近前高}
REBOUND:=
    C > REF(O,1)                         {反包昨天实体}
AND C >= HHV(C,5) * 0.96                {接近最近5日高位}
AND C >= M10
AND C >= M20;

{④ 放量确认：资金真回来}
VOLOK:=
    V > MA(V,5) * 1.5
OR  AMOUNT > MA(AMOUNT,5) * 1.4;

{⑤ K线必须是真强阳，不是骗炮}
STRONGBAR:=
    C > O
AND (C - O) / O >= 0.03                 {实体≥3%}
AND (H - C) / C < 0.035;                {上影不长}

{⑥ 情绪过滤：不过热}
RSV:=(C-LLV(L,9))/(HHV(H,9)-LLV(H,9))*100;
K:=SMA(RSV,3,1);
NOTHOT:= K < 88;

{⑦ 价格带 + 流动性过滤}
PRICEOK:= C >= 10 AND C <= 200;
LIQ:= AMOUNT > 200000000;               {成交额≥2亿}

{⑧ 最终信号：主线二波反包候选}
XG:
    FIRSTWAVE
AND PULLBACK
AND REBOUND
AND VOLOK
AND STRONGBAR
AND NOTHOT
AND PRICEOK
AND LIQ;
