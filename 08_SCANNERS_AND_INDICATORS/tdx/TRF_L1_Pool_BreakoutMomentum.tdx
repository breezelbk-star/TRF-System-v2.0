N:=20;

DIF:=EMA(C,12)-EMA(C,26);
DEA:=EMA(DIF,9);

BRKMA20:=CROSS(C,MA(C,N)) AND V>MA(V,5)*1.3;
MACDUP:=DIF>DEA;

VOL2DAY:=REF(V,0)>MA(V,5) AND REF(V,1)>MA(V,5);
VALBIG:=AMOUNT>MA(AMOUNT,5)*1.5;

RSV:=(C-LLV(L,9))/(HHV(H,9)-LLV(L,9))*100;
K:=SMA(RSV,3,1);
NOTHOT:=K<85;

TURN:=V/CAPITAL*100;

TREND:=C>MA(C,60);
NOTNEW:=BARSCOUNT(C)>120;
PRICEOK:=C>=5 AND C<=200;
LIQUID:=AMOUNT>200000000;
TURNOK:=TURN>=2 AND TURN<=20;

NEARBRK:=C>=HHV(C,20)*0.98;
SLOPEOK:=MA(C,5)>MA(C,10) AND MA(C,10)>MA(C,20);

CORE:=BRKMA20 AND MACDUP;

XG:
    CORE
AND (VOL2DAY OR VALBIG)
AND TREND
AND NOTNEW
AND PRICEOK
AND LIQUID
AND TURNOK
AND NOTHOT
AND NEARBRK
AND SLOPEOK;
