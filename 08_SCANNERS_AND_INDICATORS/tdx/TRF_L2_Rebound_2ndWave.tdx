N:=20;

M10:=MA(C,10);
M20:=MA(C,20);
M60:=MA(C,60);

FIRSTWAVE:=
    M10>M20
AND M20>M60
AND HHV(C,20)/LLV(C,20)>1.08;

PULLBACK:=
    REF(C,1)<REF(C,2)
AND REF(L,1)<=REF(M10,1)*1.02;

REBOUND:=
    C>REF(O,1)
AND C>=HHV(C,5)*0.96
AND C>=M10
AND C>=M20;

VOLOK:=
    V>MA(V,5)*1.5
OR AMOUNT>MA(AMOUNT,5)*1.4;

STRONGBAR:=
    C>O
AND (C-O)/O>=0.03
AND (H-C)/C<0.035;

RSV:=(C-LLV(L,9))/(HHV(H,9)-LLV(L,9))*100;
K:=SMA(RSV,3,1);
NOTHOT:=K<88;

PRICEOK:=C>=10 AND C<=200;
LIQ:=AMOUNT>200000000;

XG:
    FIRSTWAVE
AND PULLBACK
AND REBOUND
AND VOLOK
AND STRONGBAR
AND NOTHOT
AND PRICEOK
AND LIQ;
