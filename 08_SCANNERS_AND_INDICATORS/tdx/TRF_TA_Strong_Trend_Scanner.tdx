{========================
 TRF-T-A 强趋势放大模型
 目标：20%–35%
=========================}

MA10 := MA(C,10);
MA20 := MA(C,20);
MA30 := MA(C,30);

{一、趋势更强}
B1 := C > MA30;
B2 := MA30 > REF(MA30,3);               {MA30 明确上行}

{二、更强主升（≥30%）}
H90 := HHV(H,90);
L90 := LLV(L,90);
B3 := (H90 - L90) / L90 >= 0.30;

{三、允许更深回撤（15%–35%）}
DRAW := (H90 - C) / H90;
B4 := DRAW >= 0.15 AND DRAW <= 0.35;

{四、未被破坏}
HEAVY_SELL :=
    C < O
AND (O - C) / O > 0.07
AND V > MA(V,5)*2;
B5 := COUNT(HEAVY_SELL,10) = 0;

{五、量能可接受}
B6 := V < MA(V,10)*2.8;

{最终信号}
B1 AND B2 AND B3 AND B4 AND B5 AND B6;
