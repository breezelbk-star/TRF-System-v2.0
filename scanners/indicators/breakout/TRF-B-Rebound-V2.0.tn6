{===============================
 TRF v2.0  Jimmy 专用
 B 模块：二波反包模型（反攻主升）
 功能：抓北方华创 11/24 类结构
 作者：Gigi（定制版）
===============================}

N:=20;

{-----------------------
 ① 趋势前提：已有第一波（很关键）
-----------------------}
FIRSTWAVE :=
 MA(C,10)>MA(C,20)
 AND MA(C,20)>MA(C,60)
 AND HHV(C,20)/LLV(C,20) > 1.08;   {过去20日已有明显涨幅 = 第一波}

{-----------------------
 ② 回调逻辑：必须出现调整（不允许直线上冲）
-----------------------}
PULLBACK :=
 C<REF(C,3)
 OR C<REF(C,5)
 OR L<MA(C,10);

{-----------------------
 ③ 反包定义：今日实体吃掉前 3～5 日 K
-----------------------}
REBOUND :=
 C > REF(O,1)
 AND C >= HHV(C,5)*0.96       {≥前5天收盘96% → 反包再上}
 AND C >= MA(C,10)            {站回10日线}
 AND C >= MA(C,20);           {站回20日线}

{-----------------------
 ④ 反包必须放量（反转必备）
-----------------------}
VOLOK :=
 V > MA(V,5)*1.5
 OR AMOUNT > MA(AMOUNT,5)*1.4;

{-----------------------
 ⑤ K线必须是真强阳（不是假刺激）
-----------------------}
STRONGCANDLE :=
 C>O
 AND (H-C)/C < 0.03            {上影线<3%}
 AND (C-O)/O > 0.03;           {实体 >3%}

{-----------------------
 ⑥ 风险过滤（不过热不过度）
-----------------------}
RSV:=(C-LLV(L,9))/(HHV(H,9)-LLV(L,9))*100;
K:=SMA(RSV,3,1);
NOTHOT := K<90;

PRICEOK := C>10;               {避免低价股噪音}
LIQ := AMOUNT > 200000000;     {成交额≥2亿}

{-----------------------
 ⑦ 最终信号（全部满足）
-----------------------}
XG:
 FIRSTWAVE
 AND PULLBACK
 AND REBOUND
 AND VOLOK
 AND STRONGCANDLE
 AND NOTHOT
 AND PRICEOK
 AND LIQ;
