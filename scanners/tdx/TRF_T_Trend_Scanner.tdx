{========================
 TRF-T 可复制趋势股模型
 目标：10%–25% 波段
=========================}

MA10 := MA(C,10);
MA20 := MA(C,20);
MA30 := MA(C,30);

{一、趋势准入}
A1 := C > MA30;                         {价格在 MA30 上}
A2 := MA30 >= REF(MA30,1);              {MA30 不下拐}

{二、历史主升（≥20%）}
H60 := HHV(H,60);
L60 := LLV(L,60);
A3 := (H60 - L60) / L60 >= 0.20;

{三、合理回撤（8%–25%）}
DRAW := (H60 - C) / H60;
A4 := DRAW >= 0.08 AND DRAW <= 0.25;

{四、回撤期质量}
LONG_BEAR :=
    C < O
AND (O - C) / O > 0.05
AND V > MA(V,5)*1.5;
A5 := COUNT(LONG_BEAR,10) <= 1;

{五、量能不过热}
A6 := V < MA(V,10)*2.2;

{最终信号}
A1 AND A2 AND A3 AND A4 AND A5 AND A6;
